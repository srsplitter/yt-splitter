{
  "manifest_version": 3,
  "name": "유튜브 분할기 - 치지직 자동 전송",
  "version": "1.1",
  "description": "yt-splitter 페이지의 전송 버튼을 누르면 열려 있는 치지직 방송 채팅에 명령어를 자동 입력하고 전송합니다.",
  "background": { "service_worker": "relay.js" },
  "content_scripts": [
    {
      "matches": ["https://chzzk.naver.com/*"],
      "js": ["chat.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://srsplitter.github.io/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://chzzk.naver.com/*"]
}
